<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>XeniaSaveExportWizard</class>
 <widget class="QWizard" name="XeniaSaveExportWizard">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>620</width>
    <height>460</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Xenia Savegame Exporter</string>
  </property>
  <property name="wizardStyle">
   <enum>QWizard::ModernStyle</enum>
  </property>
  <widget class="QWizardPage" name="pageSource">
   <property name="title">
    <string>Select Xenia Save(s)</string>
   </property>
   <property name="subTitle">
    <string>Choose the Xenia profile content folder that contains the save(s) you want to export</string>
   </property>
   <layout class="QVBoxLayout" name="verticalLayout">
    <item>
     <layout class="QHBoxLayout" name="horizontalLayout">
      <item>
       <widget class="QLabel" name="lblSourcePath">
        <property name="text">
         <string>No folder selected</string>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="horizontalSpacer">
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size>
          <width>40</width>
          <height>20</height>
         </size>
        </property>
       </spacer>
      </item>
      <item>
       <widget class="QPushButton" name="btnBrowseSource">
        <property name="text">
         <string>Browse...</string>
        </property>
        <property name="autoDefault">
         <bool>false</bool>
        </property>
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <widget class="QLabel" name="lblSourceXuid">
     <property name="text">
      <string/>
     </property>
     </widget>
    </item>
    <item>
     <widget class="QTreeWidget" name="listSaves">
      <column>
       <property name="text">
        <string>Content</string>
       </property>
      </column>
      <property name="headerHidden">
       <bool>true</bool>
      </property>
     </widget>
    </item>
    <item>
     <widget class="QLabel" name="label_2">
      <property name="text">
       <string>Check the save slot(s) you want to export. The dashboard profile package (FFFE07D1) is not shown; only savegame content is supported.</string>
      </property>
      <property name="wordWrap">
       <bool>true</bool>
      </property>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QWizardPage" name="pageTarget">
   <property name="title">
    <string>Target Profile</string>
   </property>
   <property name="subTitle">
    <string>Choose the profile the exported save(s) should belong to</string>
   </property>
   <layout class="QVBoxLayout" name="verticalLayout_2">
    <item>
     <layout class="QHBoxLayout" name="horizontalLayout_2">
      <item>
       <widget class="QLabel" name="label_3">
        <property name="text">
         <string>Target profile XUID:</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLineEdit" name="txtTargetXuid">
        <property name="maxLength">
         <number>16</number>
        </property>
        <property name="placeholderText">
         <string>16 hexadecimal digits</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btnBrowseProfile">
        <property name="text">
         <string>Browse for profile package...</string>
        </property>
        <property name="autoDefault">
         <bool>false</bool>
        </property>
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <widget class="QLabel" name="lblTargetHint">
      <property name="text">
       <string>Enter a 16-digit hexadecimal XUID, or browse to any existing STFS package (a profile package or another save) owned by the target profile to read it automatically.</string>
      </property>
      <property name="wordWrap">
       <bool>true</bool>
      </property>
     </widget>
    </item>
    <item>
     <layout class="QHBoxLayout" name="horizontalLayout_4">
      <item>
       <widget class="QLabel" name="label_4">
        <property name="text">
         <string>Target console KeyVault (KV.bin):</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLineEdit" name="txtKvPath">
        <property name="placeholderText">
         <string>Optional, but required for a real console to accept the save</string>
        </property>
        <property name="readOnly">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btnBrowseKv">
        <property name="text">
         <string>Browse...</string>
        </property>
        <property name="autoDefault">
         <bool>false</bool>
        </property>
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <widget class="QLabel" name="lblKvHint">
      <property name="text">
       <string>Xbox 360 requires savegame content to be signed with the target console's own private key (its decrypted KeyVault/KV.bin, e.g. extracted with J-Runner or a similar RGH/JTAG tool). Without it, the save will only be internally consistent, not console-signed, and will be reported as corrupted by any real console (RGH/JTAG included - the signature check is not bypassed by those exploits).</string>
      </property>
      <property name="wordWrap">
       <bool>true</bool>
      </property>
     </widget>
    </item>
    <item>
     <spacer name="verticalSpacer">
      <property name="orientation">
       <enum>Qt::Vertical</enum>
      </property>
      <property name="sizeHint" stdset="0">
       <size>
        <width>20</width>
        <height>40</height>
       </size>
      </property>
     </spacer>
    </item>
   </layout>
  </widget>
  <widget class="QWizardPage" name="pageDestination">
   <property name="title">
    <string>Destination</string>
   </property>
   <property name="subTitle">
    <string>Choose where to write the exported package(s)</string>
   </property>
   <layout class="QVBoxLayout" name="verticalLayout_3">
    <item>
     <layout class="QHBoxLayout" name="horizontalLayout_3">
      <item>
       <widget class="QLabel" name="lblOutputPath">
        <property name="text">
         <string>No folder selected</string>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="horizontalSpacer_2">
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size>
          <width>40</width>
          <height>20</height>
         </size>
        </property>
       </spacer>
      </item>
      <item>
       <widget class="QPushButton" name="btnBrowseOutput">
        <property name="text">
         <string>Browse...</string>
        </property>
        <property name="autoDefault">
         <bool>false</bool>
        </property>
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <widget class="QLabel" name="lblOutputPreview">
      <property name="text">
       <string/>
      </property>
      <property name="wordWrap">
       <bool>true</bool>
      </property>
     </widget>
    </item>
    <item>
     <spacer name="verticalSpacer_2">
      <property name="orientation">
       <enum>Qt::Vertical</enum>
      </property>
      <property name="sizeHint" stdset="0">
       <size>
        <width>20</width>
        <height>40</height>
       </size>
      </property>
     </spacer>
    </item>
   </layout>
  </widget>
  <widget class="QWizardPage" name="pageConfirm">
   <property name="title">
    <string>Confirm</string>
   </property>
   <property name="subTitle">
    <string>Review and export</string>
   </property>
   <layout class="QVBoxLayout" name="verticalLayout_4">
    <item>
     <widget class="QLabel" name="lblSummary">
      <property name="text">
       <string/>
      </property>
      <property name="wordWrap">
       <bool>true</bool>
      </property>
     </widget>
    </item>
    <item>
     <widget class="QLabel" name="lblCaveat">
      <property name="text">
       <string>Note: exported packages are rehashed to be internally consistent, but are not console-signed for a specific console. They will work on Xenia and on modified (JTAG/RGH) consoles under the target profile, but will show as corrupt on an unmodified retail console.</string>
      </property>
      <property name="wordWrap">
       <bool>true</bool>
      </property>
     </widget>
    </item>
    <item>
     <spacer name="verticalSpacer_3">
      <property name="orientation">
       <enum>Qt::Vertical</enum>
      </property>
      <property name="sizeHint" stdset="0">
       <size>
        <width>20</width>
        <height>40</height>
       </size>
      </property>
     </spacer>
    </item>
   </layout>
  </widget>
 </widget>
